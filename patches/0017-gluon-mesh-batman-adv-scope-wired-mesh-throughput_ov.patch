From e503cb462ec339f07e220992c8984dcaf8d866d5 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Fri, 5 Jun 2026 20:50:22 +0000
Subject: [PATCH 17/19] gluon-mesh-batman-adv: scope wired-mesh
 throughput_override to swconfig

A VXLAN-over-Ethernet wired-mesh hardif (vx_mesh_uplink over br-wan,
vx_mesh_other over the wired mesh port) transparently reports its lower
device's ethtool/sysfs link speed, so it is excluded by tunnel_hardifs()
and batman-V reads it natively. Live verification:

  * DSA (Zyxel WSM20): a 10 Mbit-half cable in a LAN mesh port made
    vx_mesh_other report sysfs speed=10 -- batman-V already rates the
    node-to-node link correctly, no override needed.
  * swconfig (AVM FRITZ!Box 4020): the lower device is the CPU-side VLAN
    netdev eth0.1, whose sysfs speed is always the CPU port's (1000),
    regardless of the real front-panel port -- a 10 Mbit cable in port 4
    still presents as eth0.1 speed=1000, so batman-V over-rates the link
    by 100x. gluon.ethernet.get_link_speed_kbit('eth0.1') correctly
    returns 10000.

So drop the per-hardif speed source from compute_override (it only ever
needed the uplink speed for the genuinely speed-less mesh-vpn tunnel) and
add correct_swconfig_wired_mesh(), which force-applies the accurate
per-port speed to the wired-mesh hardifs on swconfig only. DSA is left to
batman-V's native ethtool path. Runs after the tunnel_hardifs loop on wan
events and the 10-minute micrond re-run; idempotent and ACTION-blind so a
wan ifdown does not clear the independent wired-mesh link.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../mesh-batman-adv/tunnel-throughput.lua     | 121 +++++++++++-------
 1 file changed, 77 insertions(+), 44 deletions(-)

diff --git a/package/gluon-mesh-batman-adv/luasrc/lib/gluon/mesh-batman-adv/tunnel-throughput.lua b/package/gluon-mesh-batman-adv/luasrc/lib/gluon/mesh-batman-adv/tunnel-throughput.lua
index c330687e..719a1803 100755
--- a/package/gluon-mesh-batman-adv/luasrc/lib/gluon/mesh-batman-adv/tunnel-throughput.lua
+++ b/package/gluon-mesh-batman-adv/luasrc/lib/gluon/mesh-batman-adv/tunnel-throughput.lua
@@ -1,12 +1,18 @@
 #!/usr/bin/lua
 
--- Apply Batman-V throughput_override to batadv hardifs that have no
--- native ethtool/sysfs link speed (mesh-vpn, and the VXLAN wired-mesh
--- hardifs vx_mesh_uplink/vx_mesh_other) so batman-V does not rate them at
--- its 1 Mbit/s default. The value depends on what the hardif rides over:
--- the WAN uplink speed for mesh-vpn and vx_mesh_uplink, the local mesh
--- port speed for vx_mesh_other. Invoked from the hotplug.d/iface wrapper,
--- which has already filtered $ACTION and $INTERFACE.
+-- Apply Batman-V throughput_override to tunnel batadv hardifs (mesh-vpn,
+-- etc.) based on the WAN interface's sysfs link speed. Invoked from the
+-- hotplug.d/iface wrapper, which has already filtered $ACTION and
+-- $INTERFACE.
+--
+-- Speed-less hardifs are targeted via tunnel_hardifs(): in practice
+-- mesh-vpn, the VXLAN-over-WireGuard tunnel. VXLAN-over-Ethernet
+-- wired-mesh hardifs (vx_mesh_uplink/vx_mesh_other) transparently report
+-- their lower device's speed via sysfs, so on DSA batman-V reads them
+-- natively and they are left alone. The exception is swconfig, where the
+-- lower device is the CPU-side VLAN netdev and its sysfs speed is the CPU
+-- port's, not the front-panel port's -- there correct_swconfig_wired_mesh()
+-- force-applies the accurate per-port speed from gluon.ethernet.
 --
 -- Triggers:
 --   ifup/ifdown wan/wan6/cellular/cellular_4 -> iterate tunnel hardifs
@@ -67,13 +73,16 @@ local function tunnel_hardifs()
 		-- no neighbours and never carries traffic, so an override there
 		-- would be cosmetic noise.
 		--
-		-- The VXLAN wired-mesh hardifs are deliberately kept:
-		-- vx_mesh_uplink (mesh-on-WAN, over br-wan) and vx_mesh_other
-		-- (mesh-on-LAN, over a dedicated wired mesh port). Both lack a
-		-- native sysfs speed, so without an override batman-V rates the
-		-- node-to-node link at its 1 Mbit/s default and routing collapses
-		-- over otherwise-fast local links. compute_override() then picks
-		-- the right speed source per hardif (uplink vs. mesh-port speed).
+		-- The VXLAN wired-mesh hardifs (vx_mesh_uplink over br-wan,
+		-- vx_mesh_other over the wired mesh port) are *not* matched here:
+		-- a VXLAN-over-Ethernet netdev transparently reports its lower
+		-- device's link speed via sysfs (verified down to 10 Mbit on a
+		-- Zyxel WSM20: vx_mesh_other tracked its lan1 port exactly), so
+		-- sysfs_speed_kbit() is non-nil for them. On DSA that speed is
+		-- correct and batman-V reads it natively; the swconfig case (where
+		-- it's the CPU-port speed) is corrected by correct_swconfig_wired_
+		-- mesh(). Only speed-less tunnels (mesh-vpn, the VXLAN-over-
+		-- WireGuard) fall through to here and need an override.
 		if iface
 			and iface ~= 'primary0'
 			and not is_wireless(iface)
@@ -113,13 +122,12 @@ end
 
 -- Min carrier-up link speed (kbit/s) across the given netdevs, or nil if
 -- none reports a usable speed (conservative bottleneck when several are
--- up). Per-port speed comes from gluon.ethernet.get_link_speed_kbit,
+-- up). Per-port speed is queried via gluon.ethernet.get_link_speed_kbit,
 -- which handles swconfig (per-port via /etc/board.json + `swconfig dev
 -- <sw> port <N> get link`) and DSA (sysfs is authoritative) transparently.
 -- Skips wireless (sysfs speed is meaningless there; mesh radios use ELP)
 -- and netdevs that don't exist yet (UCI-configured but not created, e.g.
--- USB tethers). When nothing is readable we return nil and the caller
--- declines to write an override rather than guessing.
+-- USB tethers).
 local function min_link_speed_kbit(ifaces)
 	local min_speed
 	for _, iface in ipairs(ifaces) do
@@ -138,9 +146,7 @@ local function min_link_speed_kbit(ifaces)
 end
 
 -- Active uplink throughput in kbit/s: min across every carrier-up gluon
--- role=uplink interface. Used for the hardifs whose path is the WAN
--- uplink -- mesh-vpn (the VPN tunnel) and vx_mesh_uplink (mesh-on-WAN,
--- VXLAN over br-wan).
+-- role=uplink interface. nil if none reports a usable speed.
 --
 -- Gluon's "uplink anywhere" feature lets several physical-port ifaces
 -- carry role='uplink' (e.g. on the AVM FRITZ!Box 4020 both the dedicated
@@ -162,14 +168,12 @@ local function active_uplink_speed_kbit()
 end
 
 -- Throughput of the dedicated wired node-to-node mesh ports -- role=mesh
--- but not role=uplink -- that back the vx_mesh_other hardif (mesh-on-LAN,
--- VXLAN over a dedicated wired port; see gluon_wired.sh and
--- 210-interface-mesh). This is the local link speed (often GbE), which is
--- unrelated to the WAN uplink and is exactly what batman-V needs so it
--- does not rate a fast local mesh link at its 1 Mbit/s default and route
--- horribly over it. The role split mirrors 210-interface-mesh: ifaces
--- that are mesh *and* uplink go into vx_mesh_uplink (uplink speed); the
--- rest go here. nil if no such port is carrier-up with a readable speed.
+-- but not role=uplink -- backing the vx_mesh_other hardif (mesh-on-LAN).
+-- The role split mirrors 210-interface-mesh: ifaces that are mesh *and*
+-- uplink go into vx_mesh_uplink, the rest into vx_mesh_other. Only used
+-- for the swconfig correction below (on DSA the vxlan reports the real
+-- port speed natively, so no override is needed). nil if no such port is
+-- carrier-up with a readable speed.
 local function mesh_other_speed_kbit()
 	local cursor = uci.cursor()
 	local is_uplink = {}
@@ -185,28 +189,19 @@ local function mesh_other_speed_kbit()
 	return min_link_speed_kbit(mesh_ifaces)
 end
 
--- Compute the override to apply now. Returns kbit/s on ifup if the
--- hardif's underlying link reports a readable speed, 0 on ifdown, or nil
--- if we should leave whatever is set alone (no readable speed -> no good
--- answer). The speed source depends on what the hardif rides over:
--- vx_mesh_other rides a dedicated wired mesh port (mesh-port speed);
--- mesh-vpn and vx_mesh_uplink ride the WAN uplink (uplink speed).
+-- Compute the override to apply now. Returns kbit/s on ifup if an active
+-- uplink has a readable link speed, 0 on ifdown, or nil if we should
+-- leave whatever is set alone (no readable uplink -> no good answer).
 local function compute_override(hardif)
 	if ACTION == 'ifdown' then return 0 end
-	local speed
-	if hardif == 'vx_mesh_other' then
-		speed = mesh_other_speed_kbit()
-	else
-		speed = active_uplink_speed_kbit()
-	end
+	local speed = active_uplink_speed_kbit()
 	if not speed then
 		-- On a real hotplug event this one-off warning explains why no
 		-- override was set. On the periodic (cron) tick it would just
-		-- repeat every 10 minutes (e.g. a node whose only uplink is
-		-- wireless/USB-tethered, or a mesh port with no carrier), so stay
-		-- quiet there.
+		-- repeat every 10 minutes on nodes whose only uplink is wireless
+		-- or a USB tether, so stay quiet there.
 		if not PERIODIC then
-			warn(hardif .. ': no carrier-up source port with a readable link speed; leaving default')
+			warn(hardif .. ': no active uplink with readable link speed; leaving default')
 		end
 		return nil
 	end
@@ -264,6 +259,40 @@ local function apply_override(hardif, value)
 		(current and (current .. ' kbit') or '?') .. ' -> ' .. arg)
 end
 
+-- Is a hardif registered with batadv (= present as a bat0 lower)?
+local function hardif_registered(iface)
+	return posix_stat.stat('/sys/class/net/bat0/lower_' .. iface) ~= nil
+end
+
+-- swconfig wired-mesh correction.
+--
+-- A VXLAN wired-mesh hardif (vx_mesh_uplink over br-wan, vx_mesh_other
+-- over the wired mesh port) transparently inherits its lower device's
+-- ethtool/sysfs speed. On DSA that lower is the real switch port, so
+-- batman-V reads the correct speed natively and we leave it alone -- it
+-- is deliberately not matched by tunnel_hardifs(). On swconfig the lower
+-- is the CPU-side VLAN netdev (e.g. eth0.1), whose sysfs speed is always
+-- the CPU port's (typically 1G) regardless of which front-panel port the
+-- cable is in, so batman-V mis-rates the wired mesh link. Verified on an
+-- AVM FRITZ!Box 4020: a 10 Mbit cable in a front port presents as
+-- eth0.1 speed=1000, while gluon.ethernet.get_link_speed_kbit('eth0.1')
+-- correctly reports 10000. So on swconfig only, force the override from
+-- the accurate per-port speed.
+--
+-- Like the uplink path this is blind to intra-switch cable moves at the
+-- hotplug layer (no ifup/ifdown fires); the 10-minute micrond re-run is
+-- the safety net. ACTION is ignored on purpose: the wired mesh link is
+-- independent of the wan iface, so a wan ifdown must not clear it.
+local function correct_swconfig_wired_mesh()
+	if ethernet.get_switch_type() ~= 'swconfig' then return end
+	if hardif_registered('vx_mesh_uplink') then
+		apply_override('vx_mesh_uplink', active_uplink_speed_kbit())
+	end
+	if hardif_registered('vx_mesh_other') then
+		apply_override('vx_mesh_other', mesh_other_speed_kbit())
+	end
+end
+
 -- --- main ---
 
 -- INTERFACE=mesh_vpn fires on both ifup and ifdown. On ifdown the batadv
@@ -285,3 +314,7 @@ end
 for _, hardif in ipairs(tunnel_hardifs()) do
 	apply_override(hardif, compute_override(hardif))
 end
+
+-- On swconfig, additionally correct the wired-mesh hardifs whose sysfs
+-- speed reflects the CPU port rather than the real front-panel port.
+correct_swconfig_wired_mesh()
