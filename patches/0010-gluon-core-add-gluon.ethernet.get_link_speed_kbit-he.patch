From b90fcb79e952f0f9a1f633bf0e2cc5b3c7fac6a8 Mon Sep 17 00:00:00 2001
From: Grische <github@grische.xyz>
Date: Fri, 15 May 2026 04:04:04 +0000
Subject: [PATCH 10/18] gluon-core: add gluon.ethernet.get_link_speed_kbit()
 helper

A central place to ask "how fast is this Ethernet-shaped netdev?".
sysfs is authoritative on DSA + physical NICs (each port is its own
netdev with an accurate /sys/class/net/<if>/speed). On swconfig
switches the CPU-side VLAN netdev's sysfs always reports the CPU
port's speed (typically 1G) regardless of which front-panel port the
cable is plugged into; per-port truth is only available via the
swconfig genl family (queryable through the swconfig CLI).

Implementation:
* Default path reads /sys/class/net/<iface>/speed -- correct on DSA
  and on direct netdevs (including the dedicated WAN port of swconfig
  devices that route only LAN through the switch).
* When `get_switch_type() == 'swconfig'` and the netdev appears in
  /etc/board.json's switch.<sw>.roles[].device mapping, query
  `swconfig dev <sw> port <N> get link` for each physical (untagged)
  port of that role, take the min speed across carrier-up ports.
* Returns nil when no port is carrier-up. Callers MUST be prepared to
  decline to derive a routing metric in that case rather than guess.

swconfig CLI output format ("port:N link:up speed:Xbase... ..." or
"port:N link:down") has been stable in the OpenWrt tree for ~14 years
and is the userspace-blessed contract for non-DSA switches; treating
it as parseable rather than brittle is the correct trade-off for the
3-5 year horizon over which swconfig will continue to power a large
slice of Gluon's deployed fleet (ath79, ramips, lantiq targets).

DSA migration eventually deletes the swconfig branch unchanged.

Verified live on an AVM FRITZ!Box 4020 (swconfig, ath79): with a
100M-full-duplex cable in front-panel Port 4 of a switch whose
CPU-side eth0.1 reports speed=1000, get_link_speed_kbit('eth0.1')
correctly returns 100000 (= 100M). Sysfs alone would have returned
1000000.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 .../luasrc/usr/lib/lua/gluon/ethernet.lua     | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/package/gluon-core/luasrc/usr/lib/lua/gluon/ethernet.lua b/package/gluon-core/luasrc/usr/lib/lua/gluon/ethernet.lua
index 49c9217a..c1323333 100644
--- a/package/gluon-core/luasrc/usr/lib/lua/gluon/ethernet.lua
+++ b/package/gluon-core/luasrc/usr/lib/lua/gluon/ethernet.lua
@@ -80,4 +80,82 @@ function M.get_switch_type()
 	return 'none'
 end
 
+-- Read /sys/class/net/<iface>/speed; returns kbit/s or nil for
+-- unknown/non-positive. Authoritative on DSA + physical NICs, but on a
+-- swconfig CPU-side VLAN netdev reports the CPU port's speed, not the
+-- physical port's. Callers wanting per-port accuracy on swconfig should
+-- use M.get_link_speed_kbit instead.
+local function sysfs_speed_kbit(iface)
+	local s = util.readfile('/sys/class/net/' .. iface .. '/speed')
+	if not s then return nil end
+	local n = tonumber(util.trim(s))
+	if not n or n <= 0 then return nil end
+	return n * 1000
+end
+
+-- Returns the effective link speed of an Ethernet-shaped netdev in
+-- kbit/s, or nil if it's unknown (no carrier, or kernel doesn't
+-- expose it).
+--
+-- On DSA switches and physical NICs, /sys/class/net/<iface>/speed is
+-- authoritative -- each port is its own netdev. On swconfig switches
+-- the CPU-side VLAN netdev's sysfs always reports the CPU port's
+-- speed (typically 1G) regardless of which front-panel port the cable
+-- is in. To get the real per-port speed on swconfig, derive the
+-- (switch, ports) tuple from /etc/board.json's iface->roles mapping
+-- and query `swconfig dev <sw> port <N> get link` per port. Return
+-- min across carrier-up physical ports (the bottleneck).
+--
+-- Refuses to lie: if no carrier-up port can be found, returns nil so
+-- callers can decline to derive a routing metric from this value.
+function M.get_link_speed_kbit(iface)
+	if M.get_switch_type() ~= 'swconfig' then
+		return sysfs_speed_kbit(iface)
+	end
+
+	-- swconfig only applies to interfaces declared as role-devices in
+	-- board.json. Dedicated netdevs (e.g. a separate WAN port not
+	-- routed through the switch) still have accurate sysfs speed.
+	local json = require 'jsonc'
+	local board = json.load('/etc/board.json')
+	if not board or not board.switch then
+		return sysfs_speed_kbit(iface)
+	end
+
+	for sw_name, sw in pairs(board.switch) do
+		for _, role in ipairs(sw.roles or {}) do
+			if role.device == iface then
+				local min_speed
+				for port_spec in (role.ports or ''):gmatch('%S+') do
+					-- Skip CPU port(s); tagged-CPU suffix is 't'.
+					if not port_spec:match('t$') then
+						local port_num = port_spec:match('^(%d+)')
+						if port_num then
+							-- swconfig output:
+							--   "port:N link:up speed:Xbase... ..."
+							--   "port:N link:down"
+							local cmd = string.format(
+								'swconfig dev %s port %s get link 2>/dev/null',
+								sw_name, port_num)
+							local out = util.exec(cmd) or ''
+							if not out:find('link:down') then
+								local s = out:match('speed:(%d+)base')
+								local n = s and tonumber(s)
+								if n and n > 0
+									and (not min_speed or n < min_speed) then
+									min_speed = n
+								end
+							end
+						end
+					end
+				end
+				return min_speed and min_speed * 1000 or nil
+			end
+		end
+	end
+
+	-- iface isn't in any switch role; treat as direct netdev.
+	return sysfs_speed_kbit(iface)
+end
+
 return M
